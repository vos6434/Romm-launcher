{
  "name": "romm-launcher",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run electron:dev",
    "dev:web": "vite",
    "build": "npm run build:electron",
    "build:electron": "cross-env ELECTRON_BUILD=1 tsc && vite build",
    "build:electron:linux": "npm run build:electron && electron-builder --linux AppImage --publish never",
    "build:electron:windows": "npm run build:electron && electron-builder --win nsis,portable --publish never",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev:web\" \"wait-on tcp:1420 && cross-env ELECTRON_DEV=1 ELECTRON_RENDERER_URL=http://127.0.0.1:1420 electron ./electron/main.cjs\"",
    "electron:start": "electron ./electron/main.cjs",
    "electron:build": "npm run build:electron:linux"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kacper.romm-launcher.electron",
    "productName": "RomM Launcher",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons/controller-generic.png",
      "category": "Game"
    },
    "win": {
      "icon": "build/icons/controller-generic.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
